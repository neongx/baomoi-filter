{
  "manifest_version": 3,
  "name": "Bộ lọc tin tức Baomoi.com",
  "version": "1.1",
  "description": "Tự động ẩn các tin tức chứa từ khóa hoặc nguồn cụ thể trên baomoi.com",
  "permissions": ["storage", "scripting", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://baomoi.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
